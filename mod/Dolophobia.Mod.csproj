<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Dolophobia.Mod</AssemblyName>
    <RootNamespace>Dolophobia</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- BepInEx 6 IL2CPP runs on the .NET 6 runtime it ships in <game>/dotnet. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- Override with: dotnet build -p:GameDir="D:\SteamLibrary\steamapps\common\Phasmophobia" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Phasmophobia</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <PluginOutDir>$(BepInExDir)\plugins\Dolophobia</PluginOutDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Common.dll" Private="false" />
    <!-- Generated by BepInEx on the first game launch. -->
    <Reference Include="$(BepInExDir)\interop\*.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckInterop" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(BepInExDir)\interop\Assembly-CSharp.dll')"
           Text="BepInEx interop assemblies not found in $(BepInExDir)\interop. Launch Phasmophobia once with BepInEx installed so it can generate them, then rebuild." />
  </Target>

  <Target Name="DeployPlugin" AfterTargets="Build">
    <MakeDir Directories="$(PluginOutDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginOutDir)" />
  </Target>

</Project>
